# このファイルをコピーして .env を作成する: `cp .env.example .env`
# .env は .gitignore 済み（秘匿値・ローカル設定はコミットしない）。

# --- プロジェクト/イメージ ---
PROJECT_NAME=ptcgabc
IMAGE_NAME=ptcgabc-ai-model
IMAGE_TAG=dev

# --- ビルド ---
# Pascal(GTX 1060)で安定する CUDA 12.4 ビルドを既定とする。差し替え可。
BASE_IMAGE=pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime
WORKDIR=/workspace

# --- GPU / リソース ---
GPU_COUNT=all
SHM_SIZE=2gb

# --- パス（ホスト側） ---
DATA_DIR=./data
MODELS_DIR=./models

# --- Jupyter ---
JUPYTER_PORT=8888
# ローカル開発の簡便化のため既定は空トークン。外部公開時は必ず設定すること。
JUPYTER_TOKEN=
